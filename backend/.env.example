# 复制为 .env 后修改
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret

# MySQL（推荐生产）；开发可改用 SQLite：sqlite:///instance/app.db
DATABASE_URI=mysql+pymysql://root:password@127.0.0.1:3306/sentiment_db?charset=utf8mb4

# 采集限速：每分钟最大请求数
COLLECT_MAX_REQUESTS_PER_MINUTE=30

# 首次启动且无用户时自动创建管理员（生产环境务必修改密码）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456
